/* Original CULT art direction. Scoped to the main Services page only. */
.sv-main .sv-hero {
  display: block;
  min-height: 0;
  padding: 104px 28px 25px;
  overflow: clip;
}
.sv-main .sv-hero h1 {
  position: relative;
  isolation: isolate;
  height: 54vw;
  font-family: var(--font-services-display), Impact, sans-serif;
  font-size: 25.5vw;
  font-weight: 400;
  line-height: 1;
  letter-spacing: -0.025em;
}
/* Physical print is confined to the hero: native text, no moving grain. */
.sv-main .sv-hero {
  position: relative;
  isolation: isolate;
}
.sv-main .sv-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background: url('/studies/services/riso-paper.webp') repeat;
  background-size: 768px 512px;
  filter: invert(1);
  opacity: 0.3;
}
@supports (background-clip: text) {
  .sv-main .sv-headline-row > span:not(.sv-aperture),
  .sv-main .sv-headline-last {
    background: #ece9e0 url('/studies/services/riso-paper.webp') repeat;
    background-size: 768px 512px;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
}
@media (forced-colors: active) {
  .sv-main .sv-headline-row > span:not(.sv-aperture),
  .sv-main .sv-headline-last {
    color: CanvasText;
    background: none;
  }
}
.sv-headline-row {
  display: block;
}
.sv-headline-row > span:not(.sv-aperture) {
  position: relative;
  z-index: 2;
}
.sv-main .sv-aperture {
  display: block;
  overflow: hidden;
  position: absolute;
}
.sv-aperture img {
  width: 100%;
  height: 100%;
  object-fit: cover;

}
.sv-main .sv-aperture-noct {
  top: 0;
  right: -1%;
  width: 56%;
  height: 31vw;
  transform: rotate(3deg);
  z-index: 1;
}
.sv-aperture-noct img {
  object-position: center 43%;
}
.sv-main .sv-aperture-aer {
  top: 23vw;
  left: -1%;
  width: 45%;
  height: 17.5vw;
  transform: rotate(-3deg);
  z-index: 3;
  border-left: 18px solid var(--accent);
}
.sv-aperture-aer img {
  object-position: center bottom;
}
.sv-main .sv-headline-middle > span:not(.sv-aperture) {
  position: absolute;
  top: 25vw;
  left: 42%;
  font-size: 19.4vw;
  z-index: 4;
}
.sv-main .sv-headline-last {
  display: block;
  position: absolute;
  top: 43vw;
  left: 0;
  font-size: 27.1vw;
  white-space: nowrap;
  transform: scaleY(0.48);
  transform-origin: left top;
  z-index: 5;
}
.sv-hero-baseline {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 30px;
  border-bottom: 1px solid #555;
  padding: 22px 0 12px;
}
.sv-main .sv-hero-outcomes {
  margin: 0;
  max-width: none;
  word-spacing: 8px;
  font-size: 14px;
}
.sv-main .sv-starts {
  font-size: 25px;
  white-space: nowrap;
}
.sv-main .sv-hero-credit {
  margin: 12px 0 0;
  color: #a5a5a5;
  font-size: 10px;
}
.sv-channel-rail {
  display: flex;
  gap: 24px;
  justify-content: space-between;
  flex-wrap: wrap;
  padding: 24px var(--sv-gutter);
  border-bottom: 1px solid #333;
  font:
    11px/1.5 'Courier New',
    monospace;
  color: #c8c8c8;
}
.sv-channel-rail span:nth-child(4),
.sv-channel-rail span:nth-child(8) {
  color: var(--accent);
}
.sv-main .sv-proposition {
  border: 0;
  padding-top: 75px;
  padding-bottom: 100px;
}
.sv-main .sv-system {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 0 6%;
}
.sv-main .sv-system > .sv-label {
  grid-column: 1/-1;
}
.sv-main .sv-system > .sv-display {
  font-size: 5.5vw;
  line-height: 0.96;
  margin-top: 35px;
}
.sv-main .sv-system-interaction {
  margin-top: 28px;
}
.sv-main .sv-consequence {
  min-height: 480px;
  padding-top: 35px;
}
.sv-main .sv-consequence-content > p {
  font-size: 2.8vw;
  max-width: 100%;
}
.sv-main .sv-consequence-content > p:nth-of-type(2) {
  margin-left: 12%;
}
.sv-main .sv-consequence-content > strong {
  font-size: 4vw;
  max-width: 90%;
}
.sv-main .sv-consequence-0 .sv-consequence-content > strong {
  font-size: 9vw;
}
.sv-main .sv-one-system,
.sv-main .sv-ways {
  grid-column: 1/-1;
}
.sv-main .sv-one-system h3 {
  font-size: 12.3vw;
  font-weight: 700;
  letter-spacing: -0.075em;
}
.sv-main .sv-ways {
  margin-top: 55px;
}
.sv-main .sv-ways nav span {
  font-size: 48px;
  line-height: 1.2;
}
.sv-main .sv-audit {
  position: relative;
}
.sv-main .sv-audit-rule {
  padding: 25px var(--sv-gutter);
  margin: 0;
  border: 0;
}
.sv-main .sv-audit-composition {
  display: block;
  position: relative;
  min-height: 54vw;
  padding: 20px 3.3vw 30px;
}
.sv-main .sv-audit-editorial {
  position: relative;
  z-index: 1;
  pointer-events: none;
}
.sv-main .sv-audit-title {
  font-family: var(--font-services-display), Impact, sans-serif;
  font-size: 14.6vw;
  font-weight: 400 !important;
  line-height: 0.98;
  letter-spacing: -0.025em;
}
.sv-main .sv-audit-editorial h3 {
  margin-top: 25px;
  font-size: 24px;
  max-width: 380px;
}
.sv-main .sv-audit-editorial .sv-offer-copy {
  background: #050505;
  max-width: 450px;
  font-size: 18px;
  color: white;
}
.sv-main .sv-audit-media {
  position: absolute;
  inset: 0;
  display: block;
  height: auto;
  pointer-events: none;
}
.sv-main .sv-audit-media > img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.sv-main .sv-audit-media .media {
  height: 100%;
  min-height: 0;
}
.sv-main .sv-audit-media .film-control {
  position: absolute;
  right: var(--sv-gutter);
  bottom: 25px;
  margin: 0;
  background: #050505;
  padding: 12px;
  pointer-events: auto;
  z-index: 2;
}
.sv-main .sv-diagnostic {
  margin: 0;
  padding: 20px var(--sv-gutter);
  border-top: 1px solid #333;
}
.sv-main .sv-signals,
.sv-main .sv-diagnosis {
  min-height: 135px;
}
.sv-main .sv-audit-bottom {
  padding: 38px 3.3vw;
  border: 0;
  gap: 4%;
  grid-template-columns: repeat(3, 1fr) 1.1fr;
  align-items: start;
}
.sv-main .sv-audit-bottom h3 {
  font-size: 30px;
}
.sv-main .sv-audit-bottom p {
  color: #333;
  font-size: 16px;
  margin-top: 16px;
}
.sv-main .sv-build > .sv-pad:first-child {
  position: relative;
  padding: 30px 3.3vw 32px;
  overflow: clip;
}
.sv-main .sv-build .sv-display {
  font-family: var(--font-services-display), Impact, sans-serif;
  font-size: 11.4vw;
  line-height: 1;
  font-weight: 400;
  letter-spacing: -0.025em;
  max-width: 77%;
}
.sv-build-index {
  position: absolute;
  right: -2vw;
  bottom: -0.12em;
  font-size: 42vw;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -0.09em;
  font-family: var(--font-services-display), Impact, sans-serif;
  color: #050505;
}
.sv-main .sv-build-intro {
  padding: 55px var(--sv-gutter);
  margin: 0;
  grid-template-columns: 1fr 1fr;
  background: #fff;
  color: #050505;
}
.sv-main .sv-output-controls {
  padding: 12px var(--sv-gutter);
  border-top: 1px solid #050505;
  background: #fff;
  color: #050505;
}
.sv-main .sv-output-controls > .sv-label {
  display: none;
}
.sv-main .sv-output-controls .sv-selectors {
  width: 100%;
  justify-content: space-between;
  margin: 0;
}
.sv-main .sv-output-controls button {
  font-size: 15px;
  font-weight: 600;
}
.sv-main .sv-media-proof img {
  height: auto;
  aspect-ratio: 3;
  object-fit: cover;
}
.sv-main .sv-outputs {
  display: flex;
  flex-direction: column;
  position: relative;
  margin-top: -5vw;
}
.sv-main .sv-output {
  clip-path: polygon(0 12%, 100% 0, 100% 100%, 0 100%);
}
.sv-main .sv-output:not(.sv-output-2) {
  clip-path: none;
  margin-top: 5vw;
}
.sv-main .sv-output-controls {
  order: 2;
}
.sv-main .sv-output {
  min-height: 0;
}
.sv-main .sv-output-view {
  animation: sv-expose 320ms var(--ease);
}
.sv-main .sv-partner {
  padding: 0;
  border: 0;
}
.sv-partner-rule {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 25px var(--sv-gutter);
  border-top: 1px solid #444;
}
.sv-partner-rule p + p {
  margin: 0;
}
.sv-main .sv-partner-main {
  grid-template-columns: 66% 34%;
  gap: 0;
}
.sv-partner-billboard {
  background: var(--accent);
  color: #050505;
  clip-path: polygon(0 0, 100% 0, 94% 100%, 0 100%);
  padding: 35px 2.7vw 45px;
}
.sv-main .sv-partner-title {
  font-size: 15.1vw;
  -webkit-text-stroke: 0.006em currentColor;
  font-weight: 700 !important;
  line-height: 0.84;
  letter-spacing: -0.07em;
  margin: 0 !important;
}
.sv-main .sv-partner-billboard .sv-offer-copy {
  color: #050505;
  max-width: 460px;
  font-size: 21px;
}
.sv-main .sv-partner-billboard h3 {
  margin-top: 50px;
  font-weight: 700;
  font-size: 28px;
}
.sv-main .sv-rhythm {
  padding: 25px 35px 20px;
}
.sv-main .sv-rhythm ol {
  margin-top: 12px;
  margin-bottom: 15px;
}
.sv-main .sv-rhythm li button {
  padding-top: 10px;
  padding-bottom: 10px;
}
.sv-main .sv-rhythm button strong {
  font-weight: 600;
  font-family: var(--font-services-display), Impact, sans-serif;
  font-size: 36px;
  line-height: 1;
  font-weight: 400;
}
.sv-main .sv-partner-statement {
  margin: 0;
  padding-top: 30px;
  grid-template-columns: 1fr;
  border-top: 1px solid #333;
}
.sv-main .sv-partner-statement h3 {
  font-family: var(--font-services-display), Impact, sans-serif;
  font-weight: 400;
  font-size: 5.45vw;
  letter-spacing: -0.015em;
}
.sv-main .sv-partner-statement h3 br {
  display: none;
}
.sv-main .sv-partner-statement > div {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 30px;
  margin-top: 35px;
}
.sv-main .sv-operating > .sv-light {
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  gap: 0 5%;
}
.sv-main .sv-operating > .sv-light > .sv-label {
  grid-column: 1/-1;
}
.sv-main .sv-operating > .sv-light > .sv-display {
  font-size: 4.5vw;
  line-height: 1.02;
}
.sv-main .sv-hiring {
  margin-top: 30px;
}
.sv-main .sv-hiring-sequence {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 25px;
}
.sv-main .sv-hiring-sequence button {
  display: flex;
  flex-direction: row;
  align-items: center;
  border-top: 1px solid #aaa;
  justify-content: space-between;
  gap: 10px;
  padding: 14px 0;
}
.sv-main .sv-hiring-detail {
  grid-template-columns: 1fr;
  min-height: 180px;
  gap: 15px;
  margin: 30px 0;
}
.sv-main .sv-hiring-detail > p:last-child {
  font-size: 22px;
}
.sv-main .sv-execution {
  grid-template-columns: 1fr;
}
.sv-main .sv-execution-word {
  font-size: 7.1vw;
  white-space: nowrap;
}
.sv-main .sv-execution > fieldset {
  flex-direction: row;
  justify-content: space-between;
  gap: 10px;
}
.sv-main .sv-execution button {
  font-size: 13px;
}
.sv-main .sv-capabilities > .sv-display {
  font-size: 7vw;
  font-weight: 700;
}
.sv-main .sv-start {
  background: #050505;
  color: white;
  border-top: 1px solid #444;
}
.sv-main .sv-good {
  font-size: 27vw;
  color: var(--accent);
  line-height: 0.8;
  margin: 35px 0 0;
  letter-spacing: -0.085em;
}
.sv-main .sv-start-copy {
  width: 52%;
  margin-top: 70px;
}
.sv-main .sv-start-links {
  border-color: #555;
}
.sv-main .sv-start .sv-link:hover {
  color: var(--accent);
}
.sv-main .sv-start :focus-visible {
  outline-color: var(--accent);
}
@media (max-width: 1100px) {
  .sv-main .sv-hero {
    padding-top: 130px;
    padding-left: 24px;
    padding-right: 24px;
  }
  .sv-main .sv-starts {
    font-size: 20px;
  }
  .sv-main .sv-hero-outcomes {
    font-size: 12px;
    word-spacing: 0;
  }
  .sv-main .sv-system {
    grid-template-columns: 1fr;
  }
  .sv-main .sv-system > .sv-display {
    font-size: 8.5vw;
  }
  .sv-main .sv-consequence {
    min-height: 530px;
  }
  .sv-main .sv-consequence-content > p {
    font-size: 4.5vw;
  }
  .sv-main .sv-consequence-content > strong {
    font-size: 6.5vw;
    max-width: 70%;
  }
  .sv-main .sv-consequence-0 .sv-consequence-content > strong {
    font-size: 14vw;
  }
  .sv-main .sv-rhythm {
    padding: 25px;
  }
  .sv-main .sv-rhythm button strong {
    font-size: 26px;
  }
  .sv-main .sv-partner-billboard {
    padding: 40px;
  }
  .sv-main .sv-audit-composition {
    min-height: 0;
  }
  .sv-main .sv-audit-editorial .sv-offer-copy {
    max-width: 330px;
    font-size: 17px;
  }
}
@media (max-width: 768px) {
  .sv-main .sv-hero {
    padding: 120px 20px 25px;
  }
  .sv-main .sv-hero h1 {
    font-size: 24vw;
    height: 57vw;
  }
  .sv-main .sv-headline-last {
    font-size: 25vw;
    top: 45vw;
  }
  .sv-main .sv-aperture-noct {
    width: 56%;
    height: 33vw;
    right: 0;
  }
  .sv-main .sv-aperture-aer {
    width: 46%;
    height: 20vw;
    top: 23vw;
    border-left-width: 7px;
  }
  .sv-main .sv-headline-middle > span:not(.sv-aperture) {
    top: 28vw;
    left: 41%;
    font-size: 18vw;
  }
  .sv-hero-baseline {
    align-items: flex-start;
    flex-direction: column;
    gap: 24px;
    padding-top: 30px;
  }
  .sv-main .sv-hero-outcomes {
    font-size: 13px;
    line-height: 1.8;
    max-width: 340px;
    word-spacing: 5px;
  }
  .sv-main .sv-starts {
    font-size: 26px;
  }
  .sv-main .sv-hero-credit {
    font-size: 9px;
  }
  .sv-channel-rail {
    gap: 16px 24px;
    justify-content: flex-start;
    padding: 25px 20px;
    font-size: 10px;
  }
  .sv-main .sv-proposition {
    padding-top: 55px;
    padding-bottom: 60px;
  }
  .sv-main .sv-system {
    display: block;
  }
  .sv-main .sv-system > .sv-display {
    font-size: 10.5vw;
    margin-top: 25px;
  }
  .sv-main .sv-consequence {
    min-height: 480px;
  }
  .sv-main .sv-consequence-content > p {
    font-size: 7.2vw;
  }
  .sv-main .sv-consequence-content > strong {
    font-size: 10vw;
    max-width: 90%;
  }
  .sv-main .sv-consequence-0 .sv-consequence-content > strong {
    font-size: 22vw;
  }
  .sv-main .sv-one-system h3 {
    font-size: 12vw;
  }
  .sv-main .sv-ways nav span {
    font-size: 32px;
  }
  .sv-main .sv-audit-rule {
    padding: 25px 20px;
  }
  .sv-main .sv-audit-composition {
    min-height: 0;
    padding: 35px 20px 0;
    display: flex;
    flex-direction: column;
  }
  .sv-main .sv-audit-title {
    font-size: 13.3vw;
  }
  .sv-main .sv-audit-editorial h3 {
    margin-top: 35px;
    font-size: 22px;
  }
  .sv-main .sv-audit-editorial .sv-offer-copy {
    max-width: 95%;
    font-size: 17px;
  }
  .sv-main .sv-audit-media {
    position: relative;
    height: 300px;
    margin: -70px -20px 0;
    clip-path: polygon(35% 0, 100% 0, 100% 100%, 0 100%);
    inset: auto;
  }
  .sv-main .sv-audit-media .media {
    height: 100%;
    width: 100%;
  }
  .sv-main .sv-audit-media .film-control {
    right: 20px;
    bottom: 15px;
  }
  .sv-main .sv-diagnostic {
    padding: 20px;
  }
  .sv-main .sv-signals,
  .sv-main .sv-diagnosis {
    min-height: 270px;
  }
  .sv-main .sv-audit-bottom {
    padding: 50px 20px;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .sv-main .sv-audit-bottom h3 {
    font-size: 10vw;
  }
  .sv-main .sv-build .sv-display {
    font-size: 13.6vw;
    max-width: 100%;
  }
  .sv-build-index {
    display: block;
    font-size: 30vw;
    opacity: 0.12;
  }
  .sv-main .sv-build-intro {
    padding: 35px 20px;
    grid-template-columns: 1fr;
    gap: 25px;
  }
  .sv-main .sv-output-controls {
    padding: 8px 20px;
  }
  .sv-main .sv-output-controls .sv-selectors {
    gap: 12px;
  }
  .sv-main .sv-output-controls button {
    font-size: 11px;
  }
  .sv-main .sv-output-view > div {
    min-height: 0;
  }
  .sv-main .sv-outputs {
    margin-top: 0;
  }
  .sv-main .sv-output {
    clip-path: none;
  }
  .sv-main .sv-output:not(.sv-output-2) {
    margin-top: 0;
  }
  .sv-main .sv-media-proof img {
    height: auto;
    min-height: 0;
    aspect-ratio: 3;
    object-fit: cover;
  }
  .sv-main .sv-media-proof .sv-link {
    position: static;
    padding: 15px 20px;
    display: flex;
    font-size: 13px;
    background: #050505;
    gap: 15px;
  }
  .sv-main .sv-email-proof > img {
    height: 300px;
  }
  .sv-main .sv-web-proof > img {
    height: 300px;
  }
  .sv-main .sv-partner-main {
    grid-template-columns: 1fr;
  }
  .sv-partner-rule {
    padding: 25px 20px;
    font-size: 15px;
  }
  .sv-main .sv-partner-billboard {
    padding: 40px 20px 50px;
    clip-path: polygon(0 0, 100% 0, 100% 95%, 0 100%);
  }
  .sv-main .sv-partner-title {
    font-size: 20.8vw;
  }
  .sv-main .sv-partner-billboard h3 {
    margin-top: 35px;
    font-size: 26px;
  }
  .sv-main .sv-partner-billboard .sv-offer-copy {
    font-size: 18px;
  }
  .sv-main .sv-rhythm {
    padding: 35px 20px;
  }
  .sv-main .sv-rhythm ol {
    display: block;
  }
  .sv-main .sv-rhythm button strong {
    font-size: 31px;
  }
  .sv-main .sv-partner-statement {
    padding-top: 50px;
  }
  .sv-main .sv-partner-statement > div {
    display: block;
  }
  .sv-main .sv-partner-statement h3 {
    font-size: 10vw;
  }
  .sv-main .sv-operating > .sv-light {
    display: block;
  }
  .sv-main .sv-operating > .sv-light > .sv-display {
    font-size: 10.5vw;
  }
  .sv-main .sv-hiring {
    margin-top: 35px;
  }
  .sv-main .sv-hiring-sequence button {
    font-size: 14px;
  }
  .sv-main .sv-execution-word {
    font-size: 17vw;
  }
  .sv-main .sv-execution > fieldset {
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 10px 18px;
  }
  .sv-main .sv-capabilities > .sv-display {
    font-size: 10.5vw;
  }
  .sv-main .sv-good {
    font-size: 28vw;
  }
  .sv-main .sv-start-copy {
    width: 100%;
    margin-top: 55px;
  }
  .sv-main .sv-start-links .sv-link {
    font-size: 8vw;
  }
}
@media (prefers-reduced-motion: reduce) {
  .sv-main .sv-aperture img {
    transition: none;
  }
}

.sv-main .sv-audit-title span {
  background: #050505;
  box-decoration-break: clone;
  padding: 0 0.05em 0.02em 0;
  display: inline-block;
  line-height: 0.92;
  margin-top: 0.02em;
}

.sv-main .sv-system > .sv-display,
.sv-main .sv-one-system h3,
.sv-main .sv-operating > .sv-light > .sv-display,
.sv-main .sv-capabilities > .sv-display,
.sv-main .sv-start h2 {
  font-family: var(--font-services-display), Impact, sans-serif;
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1;
}
.sv-main .sv-system > .sv-display {
  font-size: 7.2vw;
}
.sv-main .sv-one-system h3 {
  font-size: 17vw;
}
.sv-main .sv-operating > .sv-light > .sv-display {
  font-size: 6.4vw;
}
.sv-main .sv-capabilities > .sv-display {
  font-size: 9vw;
}
.sv-main .sv-audit-bottom > .sv-link {
  align-self: end;
  font-size: 22px;
}
@media (max-width: 768px) {
  .sv-main .sv-system > .sv-display,
  .sv-main .sv-operating > .sv-light > .sv-display {
    font-size: 13vw;
  }
  .sv-main .sv-capabilities > .sv-display {
    font-size: 12vw;
  }
  .sv-main .sv-audit-bottom h3 {
    font-size: 26px;
  }
  .sv-main .sv-audit-bottom {
    grid-template-columns: 1fr 1fr;
    gap: 30px 20px;
  }
  .sv-main .sv-audit-bottom > .sv-link {
    font-size: 18px;
  }
}
